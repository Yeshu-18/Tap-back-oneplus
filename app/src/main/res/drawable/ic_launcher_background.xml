<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Retro Synthwave / CRT Terminal Gradient -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:type="linear">
                <item android:color="#0A0B10" android:offset="0.0" />
                <item android:color="#101424" android:offset="0.5" />
                <item android:color="#1A0D26" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Retro Perspective Cyber Grid Lines (Horizontal) -->
    <path
        android:pathData="M0,18h108 M0,32h108 M0,46h108 M0,60h108 M0,74h108 M0,88h108 M0,100h108"
        android:strokeColor="#18233C"
        android:strokeWidth="0.8" />

    <!-- Retro Cyber Grid Lines (Vertical) -->
    <path
        android:pathData="M18,0v108 M32,0v108 M46,0v108 M62,0v108 M76,0v108 M90,0v108"
        android:strokeColor="#18233C"
        android:strokeWidth="0.8" />

    <!-- Ambient Retro Neon Radial Glow at Center Tap Point -->
    <path
        android:pathData="M54,54m-42,0a42,42 0,1,1 84,0a42,42 0,1,1 -84,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42"
                android:type="radial">
                <item android:color="#33FF2A6D" android:offset="0.0" />
                <item android:color="#1500F0FF" android:offset="0.6" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Retro Horizon Cyber Glow Baseline -->
    <path
        android:pathData="M0,106h108"
        android:strokeColor="#FF2A6D"
        android:strokeWidth="1.5" />

</vector>
